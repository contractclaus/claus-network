    },
    {
      "path": "/api/liquidity/process",
      "schedule": "2-59/5 * * * *"
    },
    {
      "path": "/api/nfts/process",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/predictions/process",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/lp-rewards/process",
      "schedule": "3-59/5 * * * *"
    },
    {
      "path": "/api/nft-staking/process",
      "schedule": "4-59/5 * * * *"
    },
    {
      "path": "/api/compute-funding/process",
      "schedule": "*/5 * * * *"
    }
  ]
}
