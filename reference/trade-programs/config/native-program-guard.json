        "@uniswap/v4-core/=lib/v4-core/",
        "solmate/=lib/v4-core/lib/solmate/"
      ],
      "outputSelection": {
        "*": {
          "*": [
            "abi",
            "evm.bytecode",
            "evm.deployedBytecode",
            "metadata",
            "storageLayout"
          ]
        }
      }
    }
  }
}