amTypes.Trade\",\"name\":\"trade\",\"type\":\"tuple\"},{\"internalType\":\"bytes\",\"name\":\"data\",\"type\":\"bytes\"}],\"name\":\"onTrade\",\"outputs\":[{\"internalType\":\"bytes4\",\"name\":\"\",\"type\":\"bytes4\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"program\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"programCodeHash\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"sender\",\"type\":\"address\"},{\"internalType\":\"bool\",\"name\":\"buy\",\"type\":\"bool\"},{\"internalType\":\"int256\",\"name\":\"amountSpecified\",\"type\":\"int256\"},{\"internalType\":\"uint160\",\"name\":\"price\",\"type\":\"uint160\"},{\"internalType\":\"uint128\",\"name\":\"liquidity\",\"type\":\"uint128\"},{\"internalType\":\"bytes\",\"name\":\"data\",\"type\":\"bytes\"}],\"name\":\"quote\",\"outputs\":[{\"internalType\":\"uint256[6]\",\"name\":\"a\",\"type\":\"uint256[6]\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"notice\":\"Adapter for native-approved trade programs. The r3 core, recipient contracts and owner rights are unchanged. This protects the native lane; it does not claim to revoke the existing human owner's setModule authority.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"TreasuryProtectedProgram.sol\":\"TreasuryProtectedProgram\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@openzeppelin/contracts/=lib/openzeppelin-contracts/contracts/\",\":@uniswap/v4-core/=lib/v4-core/\",\":solmate/=lib/v4-core/lib/solmate/\"],\"viaIR\":true},\"sources\":{\"TreasuryProtectedProgram.sol\":{\"keccak256\":\"0x84886cf6a669e98ed945a4cad535c66e93149b75b411030d0972e3d585afde96\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://ab6a858e525c97dd4b8c7cf6847447a3295b3083a2f7a627ac2a0742214b0231\",\"dweb:/ipfs/QmakxrkYC2c4jbvP1kxnxRv7yH3xR4kLepZc54CxjshHbY\"]}},\"version\":1}",
