rade\",\"name\":\"trade\",\"type\":\"tuple\"}],\"name\":\"settleCompute\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"details\":\"The permanent trading core is unchanged. The human owner still holds setModule authority; this adapter constrains the automated installation lane.\",\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"settleCompute((uint256,address,address,bool,int128,int128,uint256,uint256,uint256,uint256,bytes32))\":{\"notice\":\"Settle compute even when the inner program cannot execute. Anyone may submit an original pending receipt, once, to a fixed collector.\"}},\"notice\":\"Fixed allocation boundary for Claus' reviewed program lane.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"ComputeProtectedProgram.sol\":\"ComputeProtectedProgram\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@openzeppelin/contracts/=lib/openzeppelin-contracts/contracts/\",\":@uniswap/v4-core/=lib/v4-core/\",\":solmate/=lib/v4-core/lib/solmate/\"],\"viaIR\":true},\"sources\":{\"ComputeProtectedProgram.sol\":{\"keccak256\":\"0x594a016c8b535d5d38b66f55fd739df53a748866844d9ef142a3d6dc36fdb26e\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://ca278a1070243a9c0ea0c81305b6d74b888a0b9079df4588a1d401aaa3da3631\",\"dweb:/ipfs/QmUVyPt6ZALsfvttaB31htmtaT24z3DGHAgby9YxeSvk34\"]}},\"version\":1}",
