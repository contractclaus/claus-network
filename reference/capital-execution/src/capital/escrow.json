e\",\"type\":\"uint256\"},{\"internalType\":\"bytes32\",\"name\":\"terms\",\"type\":\"bytes32\"},{\"internalType\":\"uint8\",\"name\":\"instrument\",\"type\":\"uint8\"},{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"tokenAmount\",\"type\":\"uint256\"},{\"internalType\":\"bytes32\",\"name\":\"tokenHash\",\"type\":\"bytes32\"}],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"bytes32\",\"name\":\"termsHash\",\"type\":\"bytes32\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"Funded\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"bytes32\",\"name\":\"termsHash\",\"type\":\"bytes32\"}],\"name\":\"Refunded\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"bytes32\",\"name\":\"termsHash\",\"type\":\"bytes32\"},{\"indexed\":false,\"internalType\":\"bytes32\",\"name\":\"deliveryHash\",\"type\":\"bytes32\"}],\"name\":\"Released\",\"type\":\"event\"},{\"inputs\":[],\"name\":\"INVESTOR\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"USDC\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"amount\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"authorizationNonce\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"counterparty\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"deliveryAmount\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"deliveryCodeHash\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"deliveryToken\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"expiresAt\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint8\",\"name\":\"v\",\"type\":\"uint8\"},{\"internalType\":\"bytes32\",\"name\":\"r\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"s\",\"type\":\"bytes32\"}],\"name\":\"fund\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"mode\",\"outputs\":[{\"internalType\":\"uint8\",\"name\":\"\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"refund\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes32\",\"name\":\"deliveryHash\",\"type\":\"bytes32\"},{\"internalType\":\"uint8\",\"name\":\"v\",\"type\":\"uint8\"},{\"internalType\":\"bytes32\",\"name\":\"r\",\"type\":\"bytes32\"},{\"internalType\":\"bytes32\",\"name\":\"s\",\"type\":\"bytes32\"}],\"name\":\"release\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"state\",\"outputs\":[{\"internalType\":\"uint8\",\"name\":\"\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"termsHash\",\"outputs\":[{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{},\"notice\":\"One agreement per deployment. The counterparty deploys and relays it. No owner upgrade, arbitrary call, allowance, fee, recipient change or rescue.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"ClausCapitalEscrow.sol\":\"ClausCapitalEscrow\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@openzeppelin/contracts/=lib/openzeppelin-contracts/contracts/\",\":@uniswap/v4-core/=lib/v4-core/\",\":solmate/=lib/v4-core/lib/solmate/\"],\"viaIR\":true},\"sources\":{\"ClausCapitalEscrow.sol\":{\"keccak256\":\"0x2f6d6b286b4c0a7cd27feb2e5e66275ac113755c0c6a5504e2ff420ec590bb23\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://0a497b171f33332389fd1406fa1fdceb6c64f85c6acc8080cb0be67f2afdeff8\",\"dweb:/ipfs/Qmd8m6MvdtFK1CxSYwYCLs8n1FdpyqNyZFxMNszdaSpvvd\"]}},\"version\":1}","evidenceLevel":"compiled_only","standardInput":{"language":"Solidity","sources":{"ClausCapitalEscrow.sol":{"content":"// SPDX-License-Identifier: MIT\npragma solidity 0.8.26;\n\ninterface ICapitalToken {\n    function balanceOf(address) external view returns (uint256);\n    function transfer(address, uint256) external returns (bool);\n    function transferFrom(address, address, uint256) external returns (bool);\n    function receiveWithAuthorization(address,address,uint256,uint256,uint256,bytes32,uint8,bytes32,bytes32) external;\n}\n\n/// One agreement per deployment. The counterparty deploys and relays it.\n/// No owner upgrade, arbitrary call, allowance, fee, recipient change or rescue.\ncontract ClausCapitalEscrow {\n    address public constant INVESTOR = 0xA46A89b5b3504C1c999696de8173ec9b2eB0a01a;\n    address public constant USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;\n    bytes32 private constant DOMAIN_TYPEHASH = keccak256(\"EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)\");\n    bytes32 private constant RELEASE_TYPEHASH = keccak256(\"Release(bytes32 termsHash,bytes32 deliveryHash)\");\n    uint256 private constant HALF_ORDER = 0x7fffffffffffffffffffffffffffffff5d576e7357a4501ddfe92f46681b20a0;\n\n    address public counterparty;\n    uint256 public amount;\n    uint256 public expiresAt;\n    bytes32 public termsHash;\n    uint8 public mode; // 0: milestone; 1: atomic token allocation\n    address public deliveryToken;\n    uint256 public deliveryAmount;\n    bytes32 public deliveryCodeHash;\n    uint8 public state; // 0: unfunded; 1: escrowed; 2: released; 3: refunded\n    bool private entered;\n\n    event Funded(bytes32 indexed termsHash, uint256 amount);\n    event Released(bytes32 indexed termsHash, bytes32 deliveryHash);\n    event Refunded(bytes32 indexed termsHash);\n\n    constructor(address party,uint256 value,uint256 deadline,bytes32 terms,uint8 instrument,\n        address token,uint256 tokenAmount,bytes32 tokenHash) {\n        require(block.chainid == 8453 && party == msg.sender && party != INVESTOR, \"party\");\n        require(value > 0 && value <= 25_000_000 && deadline > block.timestamp && terms != bytes32(0), \"terms\");\n        require(instrument <= 1, \"instrument\");\n        if (instrument == 0) require(token == address(0) && tokenAmount == 0 && tokenHash == bytes32(0), \"milestone\");\n        else require(token != address(0) && token != USDC && tokenAmount > 0 && tokenHash != bytes32(0), \"token\");\n        counterparty=party; amount=value; expiresAt=deadline; termsHash=terms; mode=instrument;\n        deliveryToken=token; deliveryAmount=tokenAmount; deliveryCodeHash=tokenHash;\n    }\n\n    modifier nonReentrant() { require(!entered,\"reentry\"); entered=true; _; entered=false; }\n\n    function authorizationNonce() public view returns (bytes32) {\n        return keccak256(abi.encode(block.chainid,address(this),termsHash));\n    }\n\n    function fund(uint8 v,bytes32 r,bytes32 s) external nonReentrant {\n        require(state == 0 && block.timestamp < expiresAt,\"state\");\n        state=1;\n        uint256 beforeBalance=ICapitalToken(USDC).balanceOf(address(this));\n        ICapitalToken(USDC).receiveWithAuthorization(INVESTOR,address(this),amount,0,expiresAt,authorizationNonce(),v,r,s);\n        require(ICapitalToken(USDC).balanceOf(address(this)) == beforeBalance+amount,\"receipt\");\n        emit Funded(termsHash,amount);\n        if(mode == 1) {\n            require(deliveryToken.codehash == deliveryCodeHash,\"code\");\n            uint256 beforeTokens=ICapitalToken(deliveryToken).balanceOf(INVESTOR);\n            require(ICapitalToken(deliveryToken).transferFrom(counterparty,INVESTOR,deliveryAmount),\"delivery\");\n            require(ICapitalToken(deliveryToken).balanceOf(INVESTOR) == beforeTokens+deliveryAmount,\"quantity\");\n            state=2;\n            require(ICapitalToken(USDC).transfer(counterparty,amount),\"payment\");\n            emit Released(termsHash,bytes32(0));\n        }\n    }\n\n    function release(bytes32 deliveryHash,uint8 v,bytes32 r,bytes32 s) external nonReentrant {\n        require(mode == 0 && state == 1 && block.timestamp < expiresAt && deliveryHash != bytes32(0),\"state\");\n        bytes32 domain=keccak256(abi.encode(DOMAIN_TYPEHASH,keccak256(\"Claus Capital Escrow\"),keccak256(\"1\"),block.chainid,address(this)));\n        bytes32 message=keccak256(abi.encode(RELEASE_TYPEHASH,termsHash,deliveryHash));\n        require((v == 27 || v == 28) && uint256(s) <= HALF_ORDER && uint256(s) > 0,\"signature\");\n        require(ecrecover(keccak256(abi.encodePacked(\"\\x19\\x01\",domain,message)),v,r,s) == INVESTOR,\"investor\");\n        state=2;\n        require(ICapitalToken(USDC).transfer(counterparty,amount),\"payment\");\n        emit Released(termsHash,deliveryHash);\n    }\n\n    function refund() external nonReentrant {\n        require(mode == 0 && state == 1 && block.timestamp >= expiresAt,\"state\");\n        state=3;\n        require(ICapitalToken(USDC).transfer(INVESTOR,amount),\"refund\");\n        emit Refunded(termsHash);\n    }\n}\n"}},"settings":{"optimizer":{"enabled":true,"runs":200},"viaIR":true,"evmVersion":"cancun","metadata":{"bytecodeHash":"ipfs"},"remappings":["@openzeppelin/contracts/=lib/openzeppelin-contracts/contracts/","@uniswap/v4-core/=lib/v4-core/","solmate/=lib/v4-core/lib/solmate/"],"outputSelection":{"*":{"*":["abi","evm.bytecode","evm.deployedBytecode","metadata","storageLayout"]}}}}}